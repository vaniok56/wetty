{
  "name": "terminal-cactuz",
  "version": "4.0.0",
  "description": "A web terminal built for phones: sessions that outlive the socket, and a keyboard you can actually reach.",
  "homepage": "https://terminal.cactuz.icu",
  "license": "MIT",
  "type": "module",
  "bin": "./build/main.js",
  "main": "./build/main.js",
  "exports": "./build/server.js",
  "files": [
    "build/",
    "conf/"
  ],
  "scripts": {
    "build": "node build.js",
    "clean": "rm -rf build",
    "dev": "NODE_ENV=development concurrently --kill-others --raw --success first \"pnpm build --watch\" \"nodemon -w build -i build/client -w conf/config.json5 --delay 200ms . -- --conf conf/config.json5\"",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "start": "NODE_ENV=production node .",
    "test": "mocha",
    "prepare": "husky install",
    "icons": "python3 scripts/gen-icons.py"
  },
  "author": "Cian Butler <butlerx@notthe.cloud> (cianbutler.ie)",
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ],
    "*.{json,scss,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "compression": "^1.8.1",
    "etag": "^1.8.1",
    "express": "^5.2.1",
    "express-winston": "^4.2.0",
    "file-type": "^22.0.2",
    "fresh": "^0.5.2",
    "fs-extra": "^9.0.1",
    "helmet": "^8.3.0",
    "json5": "^2.2.3",
    "lodash": "^4.18.1",
    "node-pty": "^1.1.0",
    "parseurl": "^1.3.3",
    "prom-client": "^15.1.3",
    "response-time": "^2.3.4",
    "serve-static": "^2.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "toastify-js": "^1.9.1",
    "url-value-parser": "^2.1.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.1",
    "@types/compression": "^1.8.1",
    "@types/etag": "^1.8.0",
    "@types/express": "^5.0.6",
    "@types/fresh": "^0.5.0",
    "@types/fs-extra": "^9.0.1",
    "@types/jsdom": "^12.2.4",
    "@types/lodash": "^4.14.161",
    "@types/mocha": "^9.1.1",
    "@types/node": "^22.20.1",
    "@types/parseurl": "^1.3.1",
    "@types/response-time": "^2",
    "@types/serve-static": "^2.2.0",
    "@types/sinon": "^10.0.13",
    "@types/toastify-js": "^1.9.2",
    "@types/web-push": "^3.6.3",
    "@types/yargs": "^17.0.24",
    "@typescript-eslint/eslint-plugin": "^5.59.9",
    "@typescript-eslint/parser": "^5.59.9",
    "chai": "^4.3.6",
    "concurrently": "^8.2.2",
    "esbuild": "^0.21.5",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-sass-plugin": "^3.3.1",
    "eslint": "^8.36.0",
    "eslint-config-airbnb-base": "latest",
    "eslint-config-prettier": "^8.6.0",
    "eslint-import-resolver-typescript": "^3.4.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-mocha": "^10.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^9.0.11",
    "jsdom": "^16.5.0",
    "lint-staged": "^13.2.2",
    "mocha": "^10.0.0",
    "node-gyp": "^11.5.0",
    "nodemon": "^3.1.4",
    "prettier": "^2.5.1",
    "sass": "^1.77.6",
    "sinon": "^14.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "packageManager": "pnpm@9.4.0+sha512.f549b8a52c9d2b8536762f99c0722205efc5af913e77835dbccc3b0b0b2ca9e7dc8022b78062c17291c48e88749c70ce88eb5a74f1fa8c4bf5e18bb46c8bd83a"
}
